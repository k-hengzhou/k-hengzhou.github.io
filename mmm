    subgraph M1["① 建模准备阶段"]
        A[📋 问题分析]:::phase1 --> B[📐 模型假设]:::phase1
        B --> C[📝 模型构成]:::phase1
    end

    %% ===== 求解阶段（绿色） =====
    subgraph M2["② 求解分析阶段"]
